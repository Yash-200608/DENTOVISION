# Path to trained YOLOv8 weights. Falls back to yolov8n.pt if missing.
YOLO_MODEL_PATH=models/best.pt

# Minimum confidence for a detection to be returned (0.0-1.0).
CONFIDENCE_THRESHOLD=0.5

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Bind address for the API process.
API_HOST=0.0.0.0

# Port for the API process.
API_PORT=8000

# Reject uploads larger than this size (megabytes).
MAX_UPLOAD_SIZE_MB=10

# Comma-separated filename extensions accepted by POST /predict.
ALLOWED_EXTENSIONS=png,jpg,jpeg,dcm

# Runtime environment label returned by GET /health.
ENVIRONMENT=development
